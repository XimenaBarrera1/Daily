# ==============================================================================
# DAILY / TEMPO - VARIABLES DE ENTORNO (ENVIRONMENT CONFIGURATION)
# ==============================================================================
# INSTRUCCIONES:
# 1. Copia este archivo y nómbralo exactamente como `.env.local` en la raíz del proyecto:
#    cp .env.example .env.local    (en Mac/Linux)
#    copy .env.example .env.local  (en Windows PowerShell / CMD)
# 2. Rellena los valores reales de Supabase que te comparta tu equipo.
# 3. NUNCA subas el archivo `.env.local` a GitHub (está en .gitignore para proteger tus claves).
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase (Base de datos y Autenticación)
# ------------------------------------------------------------------------------
# Obtén estas credenciales desde: Supabase Dashboard > Project Settings > API
# O pídeselas a la administradora del proyecto en el equipo.
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Clave de servicio para tareas del servidor / cron (NO exponer en el navegador):
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# ------------------------------------------------------------------------------
# 2. Resend (Servicio de correos transaccionales y recordatorios)
# ------------------------------------------------------------------------------
# Clave gratuita obtenible en: https://resend.com/api-keys
RESEND_API_KEY=re_placeholder_123456789
RESEND_FROM_EMAIL=DAILY <onboarding@resend.dev>

# ------------------------------------------------------------------------------
# 3. Web Push API (Notificaciones Push del navegador y PWA)
# ------------------------------------------------------------------------------
# Puedes generar tu propio par de llaves VAPID ejecutando en la terminal:
# npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=BD5_placeholder...
VAPID_PRIVATE_KEY=placeholder_secret...
VAPID_SUBJECT=mailto:equipo@daily-app.com

# ------------------------------------------------------------------------------
# 4. Token de seguridad para el Scheduler / Cron
# ------------------------------------------------------------------------------
# Token secreto para validar llamadas a la ruta /api/cron/process-reminders
CRON_SECRET=daily_cron_secret_token_change_in_production

# ------------------------------------------------------------------------------
# 5. URL de la aplicación (Localhost para desarrollo)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
